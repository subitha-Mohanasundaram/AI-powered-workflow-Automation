APP_NAME=AI Workflow Automation
APP_ENV=development
APP_PORT=8000
APP_ALLOWED_ORIGINS=*

DATABASE_URL=sqlite:///./automation.db
API_ACCESS_KEY=
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# OpenAI-compatible settings
AI_API_KEY=replace_me
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30

# n8n settings
N8N_BASE_URL=http://n8n:5678
N8N_EXECUTION_WEBHOOK_PATH=/webhook/execute-workflow
N8N_TIMEOUT_SECONDS=45
N8N_RETRY_ATTEMPTS=3
N8N_RETRY_BACKOFF_SECONDS=1.0

# Result channels
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_user
SMTP_PASSWORD=your_password
EMAIL_FROM=no-reply@example.com

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
