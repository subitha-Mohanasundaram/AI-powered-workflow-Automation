# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_PORT=8000
APP_ALLOWED_ORIGINS=*        # Comma-separated origins, e.g. https://app.example.com
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ── Database ────────────────────────────────────────────────────────────────────
# SQLite (default, development only):
DATABASE_URL=sqlite:///./automation.db
# PostgreSQL (recommended for staging/production):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# ── API Security ────────────────────────────────────────────────────────────────
# Set to a strong random string to require X-API-Key on all /api/* endpoints.
# Leave empty to disable API key requirement (open access).
API_ACCESS_KEY=
# Token required to access /dashboard.  Leave empty to allow open access.
DASHBOARD_TOKEN=
# Rate limiting (per user/IP per window)
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ── AI / LLM ────────────────────────────────────────────────────────────────────
# REQUIRED for LLM interpretation.  Without this the system uses rule-based fallback.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30

# ── n8n ─────────────────────────────────────────────────────────────────────────
# Base n8n URL (used when N8N_WEBHOOK_URL is not set)
N8N_BASE_URL=http://localhost:5678
N8N_EXECUTION_WEBHOOK_PATH=/webhook/execute-workflow
# Full webhook URL (overrides N8N_BASE_URL + N8N_EXECUTION_WEBHOOK_PATH when set)
N8N_WEBHOOK_URL=
N8N_TIMEOUT_SECONDS=45
N8N_RETRY_ATTEMPTS=3
N8N_RETRY_BACKOFF_SECONDS=1.0

# ── SMTP (optional email delivery) ──────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com

# ── Slack (optional Slack delivery) ─────────────────────────────────────────────
# Incoming Webhook URL from https://api.slack.com/apps
SLACK_WEBHOOK_URL=

# ── Database retention ───────────────────────────────────────────────────────────
# Workflow runs older than this many days are deleted by the cleanup job.
RUN_RETENTION_DAYS=90
