          { "name": "severity", "value": "={{$json.computed_severity}}" },
          { "name": "affected_service", "value": "payment-api" },
          { "name": "probable_root_cause", "value": "Elevated errors detected; collect more telemetry" },
          { "name": "error_rate_percent", "value": "={{$json.incident_metrics.error_rate_percent}}" },
          { "name": "priority_message", "value": "Non-critical incident." },
          { "name": "recommended_actions", "value": "Monitor, assign owner, schedule fix" },
          { "name": "api_updated_time", "value": "={{$now}}" }
        ],
