{
  "name": "Demo - Incident Triage (Webhook)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "execute-workflow",
        "responseMode": "responseNode"
      },
      "id": "Webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [320, 260]
    },
    {
      "parameters": {
        "url": "https://httpbin.org/json",
        "method": "GET",
        "responseFormat": "json"
      },
      "id": "HTTP Request",
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [540, 260]
    },
    {
      "parameters": {
        "jsCode": "const errorRate = 28; // demo metric\\nlet severity = 'P3';\\nif (errorRate >= 25) severity = 'P1';\\nelse if (errorRate >= 10) severity = 'P2';\\n\\nreturn [{\\n  json: {\\n    ...$json,\\n    incident_metrics: { error_rate_percent: errorRate },\\n    computed_severity: severity\\n  }\\n}];"
      },
      "id": "Code",
      "name": "Code in JavaScript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [760, 260]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.computed_severity}}",
              "operation": "equals",
              "value2": "P1"
            }
          ]
        }
      },
      "id": "If",
      "name": "If",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [980, 260]
    },
    {
      "parameters": {
        "mode": "manual",
        "fieldsToSet": [
          { "name": "status", "value": "success" },
          { "name": "run_id", "value": "={{$node[\"Webhook\"].json.body.run_id}}" },
          { "name": "workflow_name", "value": "={{$node[\"Webhook\"].json.body.workflow_name}}" },
          { "name": "severity", "value": "={{$json.computed_severity}}" },
          { "name": "affected_service", "value": "payment-api" },
          { "name": "probable_root_cause", "value": "Database connection pool saturation after latest deploy" },
          { "name": "error_rate_percent", "value": "={{$json.incident_metrics.error_rate_percent}}" },
          { "name": "priority_message", "value": "Critical incident. Act now." },
          { "name": "recommended_actions", "value": "Immediate rollback, on-call escalation, incident bridge" },
          { "name": "api_updated_time", "value": "={{$now}}" }
        ],
        "includeOtherInputFields": true
      },
      "id": "Edit Fields P1",
      "name": "Edit Fields (P1)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1210, 180]
    },
    {
